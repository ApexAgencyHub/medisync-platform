{
  "name": "medisync-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter \"./packages/*\" build && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "test:e2e": "pnpm --filter @medisync/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
