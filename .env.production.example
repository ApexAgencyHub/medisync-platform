# MediSync Global Production Environment Variables
# Generate a hardened .env.production automatically:
#   node deploy/provision-env.mjs --init --domain app.yourdomain.ma --out .env.production
# Validate before booting:
#   node deploy/provision-env.mjs --check --file .env.production

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=true
ENABLE_REQUEST_LOGS=true
DEFAULT_COUNTRY_CODE=MA

# Public Domain & Automatic HTTPS/TLS (Caddy)
APP_DOMAIN=app.medisync.example.com
CORS_ORIGINS=https://app.medisync.example.com
NEXT_PUBLIC_API_URL=https://app.medisync.example.com
NEXT_PUBLIC_DEFAULT_COUNTRY=MA

# Database & Cache (POSTGRES_PASSWORD must match password in DATABASE_URL)
POSTGRES_USER=medisync
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://medisync:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/medisync
DB_POOL_MAX=35
DB_STATEMENT_TIMEOUT_MS=12000
REDIS_URL=redis://redis:6379

# Cryptography & Session Cookies (generate with: openssl rand -hex 32)
AUTH_SECRET=CHANGE_ME_MINIMUM_32_CHARS_HIGH_ENTROPY_SECRET
COOKIE_SECURE=true

# Object Storage (AWS S3 / Cloudflare R2 / Self-Hosted MinIO Cluster)
# Apply deploy/s3-cors.json or set S3_AUTO_CONFIGURE_CORS=true to enable direct browser SigV4 uploads on AWS S3/R2.
# For --profile self-hosted-s3 (MinIO), set S3_PUBLIC_DOMAIN=media.yourdomain.ma and S3_AUTO_CONFIGURE_CORS=false (MinIO reads MINIO_API_CORS_ALLOW_ORIGIN).
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://cdn.medisync.example.com
S3_PUBLIC_DOMAIN=
S3_REGION=eu-west-1
S3_BUCKET=medisync-clinical-media-prod
S3_ACCESS_KEY_ID=CHANGE_ME_S3_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_MIN_32_CHARS
S3_PRESIGN_EXPIRES_SECONDS=900
S3_AUTO_CONFIGURE_CORS=true

# Telehealth WebRTC TURN/STUN Relay (coturn ephemeral HMAC-SHA1 credentials)
TURN_REALM=turn.medisync.example.com
# Optional 1:1 NAT mapping on cloud VMs (e.g. PUBLIC_IP/PRIVATE_IP or PUBLIC_IP):
TURN_EXTERNAL_IP=
# Optional TLS cert/key paths mounted inside coturn to enable turns: on TCP 5349:
TURN_TLS_CERT=
TURN_TLS_PKEY=
TELEHEALTH_TURN_URLS=turn:turn.medisync.example.com:3478?transport=udp,turn:turn.medisync.example.com:3478?transport=tcp
TELEHEALTH_TURN_STATIC_AUTH_SECRET=CHANGE_ME_TURN_HMAC_SECRET_MIN_32_CHARS
TELEHEALTH_TURN_TTL_SECONDS=3600
TELEHEALTH_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional explicit ICE JSON override (takes precedence over TELEHEALTH_TURN_URLS when non-empty):
# Example: [{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.yourdomain.ma:3478"],"username":"u","credential":"p"}]
TELEHEALTH_ICE_SERVERS_JSON=

# Regulatory & Verification Gates (NEVER set ALLOW_DEV_SEED=true in production)
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_PROVIDER_VERIFICATION=true
ENABLE_DEV_OTP_PREVIEW=false
ALLOW_SIMULATED_PAYMENTS=false

# External Providers (Transactional OTP & PSP Webhook)
SMTP_WEBHOOK_URL=https://notifications.medisync.example.com/email-otp
SMS_WEBHOOK_URL=https://notifications.medisync.example.com/sms-otp
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PSP_WEBHOOK_SECRET_MIN_16_CHARS
GOOGLE_CLIENT_ID=

# Rate Limits
RATE_LIMIT_MAX_PER_MIN=600
AUTH_RATE_LIMIT_MAX_PER_MIN=30
