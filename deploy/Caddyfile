# MediSync Global — Production Automatic HTTPS/TLS Edge Proxy (Caddy 2)
# Set APP_DOMAIN=app.yourdomain.ma in .env.production for automatic Let's Encrypt TLS 1.3 + HTTP/3.
# Set APP_DOMAIN=:80 when terminating TLS upstream (Cloudflare Tunnel / AWS ALB).
# Set S3_PUBLIC_DOMAIN=media.yourdomain.ma when running --profile self-hosted-s3 (MinIO).
{
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 0
			idle 2m
		}
	}
}

{$APP_DOMAIN::80} {
	encode zstd gzip

	request_body {
		max_size 52MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Block internal Prometheus/JSON telemetry endpoints on the public edge
	@internal_metrics {
		path /metrics /v1/metrics
	}
	respond @internal_metrics 404

	# SSE Live Dispatch & Telehealth WebRTC Signaling Streams (zero buffering)
	@sse_streams {
		path_regexp sse ^/v1/(dispatch/stream|telehealth/sessions/[^/]+/stream)$
	}
	handle @sse_streams {
		reverse_proxy api:4000 {
			flush_interval -1
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Public API & liveness/readiness probes
	@api_routes {
		path /v1/* /health /ready
	}
	handle @api_routes {
		reverse_proxy api:4000 {
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
		}
	}

	# Next.js Standalone Web App
	handle {
		reverse_proxy web:3000 {
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
		}
	}
}

# Self-hosted MinIO S3 Public Endpoint (active on HTTPS when S3_PUBLIC_DOMAIN=media.yourdomain.ma;
# falls back to container-internal :9000 when using external AWS S3 / Cloudflare R2).
{$S3_PUBLIC_DOMAIN::9000} {
	request_body {
		max_size 52MB
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy minio:9000 {
		header_up Host {http.request.host}
	}
}
